<scenario date="${DATE}" description="${DESC}">

   <task service="DDVCSGeneratorService" method="generate">

      <general_configuration>
         <param name="number_of_events" value="${NEVENTS}" />
         <param name="histogram_file_path" value="${HISTO_FILE}" />
         <param name="subprocess_type" value="${SUBPROCESS}" />
      </general_configuration>

      <kinematic_range>
         <param name="range_y" value="0.0|1.0" />
         <param name="range_Q2" value="${Q2_RANGE}" />
         <param name="range_t" value="${T_RANGE}" />
         <param name="range_Q2Prim" value="${Q2P_RANGE}" />
         <param name="range_phi" value="0.0|6.28318" />
         <param name="range_phiS" value="0.0|6.28318" />
         <param name="range_phiL" value="0.0|6.28318" />
         <param name="range_thetaL" value="0.031416|3.110177" />
         <param name="range_xB" value="0.0|1." />
      </kinematic_range>

      <experimental_conditions>
         <param name="lepton_energy" value="${LEP_E}" />
         <param name="lepton_type" value="e-" />
         <param name="decay_type" value="${DECAY_TYPE}" />
         <param name="hadron_energy" value="${HAD_E}" />
         <param name="hadron_type" value="p" />
	 <param name="hadron_polarisation" value="${HAD_POL}" />
      </experimental_conditions>

      <!-- everything else unchanged -->

      <writer_configuration>
         <module type="WriterModule" name="WriterHepMC3">
            <param name="output_file_path" value="${OUT_FILE}" />
            <param name="HepMC3_writer_type" value="ascii" />
         </module>
      </writer_configuration>

   </task>
</scenario>
