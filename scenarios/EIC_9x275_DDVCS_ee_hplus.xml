<scenario date="2026-05-05" description="DDVCS scan">

   <task service="DDVCSGeneratorService" method="generate">

      <general_configuration>
         <param name="number_of_events" value="1000000" />
         <param name="histogram_file_path" value="output/9x275_DDVCS_ee_hplus.root" />
         <param name="subprocess_type" value="ALL" />
      </general_configuration>

      <kinematic_range>
         <param name="range_y" value="0.0|1.0" />
         <param name="range_Q2" value="0.0|10.0" />
         <param name="range_t" value="-2.|-0.0001" />
         <param name="range_Q2Prim" value="2.|18." />
         <param name="range_phi" value="0.0|6.28318" />
         <param name="range_phiS" value="0.0|6.28318" />
         <param name="range_phiL" value="0.0|6.28318" />
         <param name="range_thetaL" value="0.031416|3.110177" />
         <param name="range_xB" value="0.0|1." />
      </kinematic_range>

      <experimental_conditions>
         <param name="lepton_energy" value="9" />
         <param name="lepton_type" value="e-" />
         <param name="decay_type" value="e-" />
         <param name="hadron_energy" value="275" />
         <param name="hadron_type" value="p" />
	 <param name="hadron_polarisation" value="" />
      </experimental_conditions>

      <!-- everything else unchanged -->

      <writer_configuration>
         <module type="WriterModule" name="WriterHepMC3">
            <param name="output_file_path" value="output/9x275_DDVCS_ee_hplus.hepmc" />
            <param name="HepMC3_writer_type" value="ascii" />
         </module>
      </writer_configuration>

   </task>
</scenario>
